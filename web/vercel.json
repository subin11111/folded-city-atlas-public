{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["icn1"],
  "functions": {
    "api/dispatch.py": {
      "maxDuration": 60,
      "includeFiles": "{server.py,navigation.py,walk.py,photo_library.py,public/data/{navigation,catalog,photos,photo_regions,photo_library,photo_views}.json}",
      "excludeFiles": "{node_modules/**,**/__pycache__/**,tests/**,test_*,scripts/**,public/{models,photos,photos_full,photos_corrected,photo_thumbs,photo_audit,vendor,brand,research}/**}"
    }
  },
  "rewrites": [
    {"source": "/api/route", "destination": "/api/dispatch?endpoint=route"},
    {"source": "/api/health", "destination": "/api/dispatch?endpoint=health"},
    {"source": "/api/walk/start", "destination": "/api/dispatch?endpoint=walk/start"},
    {"source": "/api/walk/options", "destination": "/api/dispatch?endpoint=walk/options"},
    {"source": "/api/walk/move", "destination": "/api/dispatch?endpoint=walk/move"}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}]},
    {"source": "/api/(.*)", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/data/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]},
    {"source": "/(photos_full|photos_corrected|photo_thumbs|models)/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=3600, must-revalidate"}]},
    {"source": "/(.*)", "headers": [{"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"}]}
  ]
}
